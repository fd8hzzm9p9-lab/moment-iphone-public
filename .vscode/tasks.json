{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧠 Serveur Moment",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\terminal-projet.ps1\" -Role server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "moment-backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "☁️ Cloudflare",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\terminal-projet.ps1\" -Role cloudflare",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "moment-backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "📱 Expo",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\terminal-projet.ps1\" -Role expo",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "moment-frontend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "📊 Crédits testeurs",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\ouvrir-tableau-testeurs.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    {
      "label": "🚀 Démarrer Moment",
      "dependsOn": [
        "🧠 Serveur Moment",
        "☁️ Cloudflare",
        "📱 Expo",
        "📊 Crédits testeurs"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
