{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧠 Serveur MomentDEV",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\terminal-projet.ps1\" -Role server",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "3001"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "momentdev-backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "☁️ Cloudflare MomentDEV",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\terminal-projet.ps1\" -Role cloudflare",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "momentdev-backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "📱 Expo MomentDEV",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\terminal-projet.ps1\" -Role expo",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "momentdev-frontend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "📊 Crédits MomentDEV",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\ouvrir-tableau-testeurs.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    {
      "label": "🚀 Démarrer MomentDEV",
      "dependsOn": [
        "🧠 Serveur MomentDEV",
        "☁️ Cloudflare MomentDEV",
        "📱 Expo MomentDEV",
        "📊 Crédits MomentDEV"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
