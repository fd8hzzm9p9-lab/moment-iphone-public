        const explicitDate =
          extractExplicitDateFromText(
            text
          );

        if (
          explicitDate
        ) {
          dateReference =
            explicitDate;
        } else if (
          correctionDate
        ) {
          dateReference =
            correctionDate;
        }

        if (
          !dateReference &&
          correctionDate
        ) {
          const resolved =
            extractCalendarDateFromText(
              correctionDate
            );

          if (
            resolved
          ) {
            dateReference =
              resolved;
          }
        }

        let oldValue =
          correctionData.old_value
            ? correctionData.old_value.trim()
            : '';

        let newValue =
          correctionData.new_value
            ? correctionData.new_value.trim()
            : '';

        if (
          !oldValue &&
          oldTime
        ) {
          oldValue =
            oldTime;
        }

        if (
          !newValue &&
