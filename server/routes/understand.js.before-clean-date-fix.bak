                true,

              type:
                correctionContext ===
                'travail'
                  ? 'work_schedule'
                  : 'generic',

              person:
                person || '',

              date:
                dateReference || '',

              day:
                day || '',

              context:
                correctionContext || '',

              old_value:
                oldValue,

              new_value:
                newValue,

              old_time:
                oldTime || null,

              new_time:
                newTime || null,

              old_time_range:
                oldStart &&
