        console.log(
          'Ã¢Å“ÂÃ¯Â¸Â DEMANDE DE CORRECTION DÃƒâ€°TECTÃƒâ€°E'
        );

        const correctionPrompt = `
Tu es le moteur de comprÃƒÂ©hension des corrections de l'application Moment.

L'utilisateur demande de modifier une information qui peut dÃƒÂ©jÃƒÂ 
