        ) {
          oldValue =
            `${oldStart} ÃƒÂ  ${oldEnd}`;
        }

        if (
          !newValue &&
          newStart &&
          newEnd
        ) {
          newValue =
            `${newStart} ÃƒÂ  ${newEnd}`;
        }

        const normalizedRequest =
          normalizeText(
            text
          );

        if (
          normalizedRequest.includes(
            'au lieu de'
          )
        ) {
          const parts =
            normalizedRequest.split(
              'au lieu de'
            );

          if (
            parts.length >= 2
          ) {
            const before =
              parts[0];

            const after =
              parts
                .slice(1)
                .join(
                  ' au lieu de '
                );

            const timesBefore = [
              ...before.matchAll(
                /\b([01]?\d|2[0-3])h(?:([0-5]\d))?\b/gi
              ),
            ].map(
              match =>
                `${match[1]}h${
                  match[2] || ''
                }`
            );

            const timesAfter = [
              ...after.matchAll(
                /\b([01]?\d|2[0-3])h(?:([0-5]\d))?\b/gi
              ),
            ].map(
              match =>
                `${match[1]}h${
                  match[2] || ''
                }`
            );

            if (
              timesBefore.length ===
                1 &&
              timesAfter.length ===
                1
            ) {
              newTime =
                timesBefore[0];

              oldTime =
                timesAfter[0];

              oldValue =
                oldTime;

              newValue =
                newTime;
            }

            if (
              timesBefore.length ===
                2 &&
              timesAfter.length ===
                2
            ) {
              newStart =
                timesBefore[0];

              newEnd =
                timesBefore[1];

              oldStart =
                timesAfter[0];

              oldEnd =
                timesAfter[1];

